# Express API + workers environment variables.
# This service runs on a long-running platform (Railway, Fly.io, Render,
# Heroku, or a VM) — NOT on Vercel — because pg-boss workers and the
# event-dispatcher loop require persistent processes.

# --- Database (required) ---
# Postgres connection string. Used by lib/db/src/index.ts (pg pool) and
# pg-boss (artifacts/api-server/src/lib/queue.ts). Provider must support
# `LISTEN`/`NOTIFY` and `pg_advisory_lock` (Supabase, Neon, Railway, RDS, etc.).
DATABASE_URL=postgresql://user:password@host:5432/torgima

# --- Anthropic / Bhudhi (required for Bhudhi-backed validation/structuring) ---
# Preferred: API key variable name used by Bhudhi in this codebase.
ANTHROPIC_API_KEY=sk-ant-...
# Legacy (still respected if ANTHROPIC_API_KEY is unset):
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
# Optional override for the API base URL (proxies, regional endpoints).
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Defaults below if unset.
# BHUDHI_MODEL=claude-sonnet-4-20250514
# BHUDHI_MAX_TOKENS=4096

# Per-tier daily call caps (Bhudhi). Defaults: 20 / 50 / 200.
# BHUDHI_DAILY_CALL_CAP_STARTER=20
# BHUDHI_DAILY_CALL_CAP_GROWTH=50
# BHUDHI_DAILY_CALL_CAP_ULTIMATE=200

# --- Outbound email via Resend (required for production magic links) ---
# When unset, sendMagicLink falls back to logging the link in dev mode and
# returns { sent: false } in prod (auth will not function for new users).
RESEND_API_KEY=re_...
# Webhook signing secret for POST /api/webhooks/notifications/bounce (Svix / Resend webhooks).
# RESEND_WEBHOOK_SECRET=whsec_...
EMAIL_FROM=noreply@torgima.com
EMAIL_REPLY_TO=support@torgima.com

# Worker-to-API authentication (required in production).
INTERNAL_AUTH_SECRET=

# Allowed browser origin for credentialed CORS (SPA on Vercel). Comma-separated for multiple preview URLs.
FRONTEND_URL=https://your-app.vercel.app

# Base URL for outbound email links (optional; falls back to APP_URL or REPLIT_DOMAINS in dev).
APP_URL=https://your-app.vercel.app

# --- Logging / runtime ---
NODE_ENV=production
LOG_LEVEL=info
