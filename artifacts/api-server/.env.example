DATABASE_URL=
DIRECT_URL=
PGBOSS_DATABASE_URL=
ANTHROPIC_API_KEY=
BHUDHI_MODEL=claude-sonnet-4-20250514
RESEND_API_KEY=
EMAIL_FROM=noreply@your-verified-domain.com
NOTIFICATION_UNSUBSCRIBE_SECRET=
INTERNAL_AUTH_SECRET=

# Super Admin panel (/admin on the SPA). All three required or /api/admin returns 403.
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_SESSION_SECRET=generate-a-32-char-random-string
# Set STRICT_STARTUP_PREFLIGHT=true to exit when migrations/schema checks fail (default: warn only).
# STRICT_STARTUP_PREFLIGHT=

# Optional: run pnpm db:apply-manual in the background after HTTP is listening (local Node only).
# RUN_DB_APPLY_MANUAL_ON_START=true

# Delay before pg-boss workers start (ms). Default 15000 for local Node server.
# WORKER_START_DELAY_MS=15000

# Browser origin(s) for CORS and magic-link URLs in email. Must host the SPA (/auth/callback).
# Production: https://torgima.com (Cloudflare Pages). Not the marketing site alone.
FRONTEND_URL=https://torgima.com
RESEND_WEBHOOK_SECRET=
APP_VERSION=phase1
PORT=3001
NODE_ENV=production
