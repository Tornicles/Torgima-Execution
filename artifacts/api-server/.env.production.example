# BHUDHI PROMPT 37 — Production API environment (copy to host secrets; do not commit real values)

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres
PGBOSS_DATABASE_URL=

# Auth & app
INTERNAL_AUTH_SECRET=
FRONTEND_URL=https://torgima-execution.vercel.app
NODE_ENV=production
PORT=3001
APP_VERSION=2.0.0

# AI providers
ANTHROPIC_API_KEY=
BHUDHI_MODEL=claude-sonnet-4-20250514
# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@your-verified-domain.com

# Optional cache (Upstash REST — leave empty to use in-memory rate limiting)
REDIS_URL=

# Queue (pg-boss uses DATABASE_URL / PGBOSS_DATABASE_URL)
PG_BOSS_CONNECTION_STRING=

# Observability
LOG_LEVEL=info
SENTRY_DSN=
DATADOG_API_KEY=

# Feature flags
ENABLE_MONITORING=true
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Startup
STRICT_STARTUP_PREFLIGHT=false
WORKER_START_DELAY_MS=15000
