# Frontend env vars consumed by Vite at build time.
# Copy to .env.local for local development, OR set these in the Vercel project
# dashboard (Settings -> Environment Variables) for deployed environments.
#
# All Vite env vars MUST be prefixed with VITE_ to be exposed to the browser.

# Origin of the Torgima API (Express server hosted on Railway / Fly.io / Render).
# - Required for any deployment where the API is on a different origin than the
#   SPA (e.g. SPA on Vercel, API on Railway).
# - Leave UNSET when running locally and the API is reachable on the same
#   origin via Vite's proxy (or when SPA + API share an origin).
# - No trailing slash.
VITE_API_BASE_URL=https://api.torgima.example.com

# --- Dev-only env vars (NOT used by `vite build`) ---
# These are required by `vite dev` / `vite preview` only. Vercel's build never
# runs the dev server, so they are not needed in the Vercel dashboard.
PORT=5173
BASE_PATH=/
