# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Secrets — never commit local env files
.env
.env.local
.env.*.local
.env*.local
*.env
.env.production
.env.production.local

# Docx extraction artifacts (local reference only)
_phase*.zip
_phase*_docx/
_phase*_extracted.txt
_doc*.zip
_doc*_docx/
_doc*_extracted.txt
.env.staging

# Dependencies
pnpm-store/
.pnpm-store/

# Build outputs (common toolchains)
dist/
build/
.next/
out/
out-tsc
tmp

# Test artifacts
coverage/
*.lcov
test-results/
playwright-report/

# Local agent / typecheck dumps (do not commit)
typecheck*.txt
unit-test-out.txt

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary
*.tmp
*.temp

# One-off scripts with keys risk
scripts/test-anthropic.ts

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# Dependencies
node_modules/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode (keep shared tasks/extensions; exclude local-only settings)
.vscode/settings.json
.vscode/*.code-workspace
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Editor swaps
*.swp
*.swo

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
