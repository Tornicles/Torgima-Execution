# Production environment template — names only. Copy for local reference; never commit real values.
# Worker runtime secrets: use `pnpm cf:secrets:worker` (wrangler secret put).
# Frontend build: set VITE_API_BASE_URL in Cloudflare Pages project settings.
# CI: configure GitHub Actions secrets/vars (see docs/CLOUDFLARE_MIGRATION.md).

DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
INTERNAL_AUTH_SECRET=
NOTIFICATION_UNSUBSCRIBE_SECRET=

VITE_API_BASE_URL=https://api.torgima.com
NODE_ENV=production
TORGIMA_RUNTIME=cloudflare
APP_URL=https://torgima.com
FRONTEND_URL=https://torgima.com
