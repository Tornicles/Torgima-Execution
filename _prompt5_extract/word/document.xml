<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document mc:Ignorable="w14 w15 wp14" xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex"><w:body><w:p><w:pPr><w:spacing w:after="200" w:before="1440"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="72"/><w:szCs w:val="72"/></w:rPr><w:t xml:space="preserve">TORGIMA</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="200" w:before="0"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr><w:t xml:space="preserve">CURSOR BUILD PROMPT</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="200" w:before="0"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="D44000"/><w:sz w:val="34"/><w:szCs w:val="34"/></w:rPr><w:t xml:space="preserve">PROMPT 5 — ERECTOR ADDITIONS</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="160" w:before="0"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:sz w:val="30"/><w:szCs w:val="30"/></w:rPr><w:t xml:space="preserve">Erector Additions — Execution Engine</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="800" w:before="0"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:i/><w:iCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Archetype Multipliers Active in All Three Execution Loops</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:pBdr><w:bottom w:val="single" w:color="D44000" w:sz="4" w:space="1"/></w:pBdr><w:spacing w:after="160" w:before="360"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="34"/><w:szCs w:val="34"/></w:rPr><w:t xml:space="preserve">A — PURPOSE</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">This prompt extends the three-loop execution engine (primary, daily, background) with active archetype intelligence. Prompt 4 locked archetype data onto the blueprint and seeded first week tasks. This prompt makes the running execution engine read and apply that data on every cycle.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Run this prompt AFTER Prompt 5 (the main 3-loop engine) is verified working. This is an addition to a working system, not a replacement.</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:pBdr><w:bottom w:val="single" w:color="D44000" w:sz="4" w:space="1"/></w:pBdr><w:spacing w:after="160" w:before="360"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="34"/><w:szCs w:val="34"/></w:rPr><w:t xml:space="preserve">B — READ BEFORE TOUCHING ANYTHING</w:t></w:r></w:p><w:p><w:pPr><w:pBdr><w:left w:val="single" w:color="D44000" w:sz="12" w:space="6"/></w:pBdr><w:spacing w:after="100" w:before="100"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Read src/workers/WorkerRegistry.ts completely. Understand which workers exist and how they are registered.</w:t></w:r></w:p><w:p><w:pPr><w:pBdr><w:left w:val="single" w:color="D44000" w:sz="12" w:space="6"/></w:pBdr><w:spacing w:after="100" w:before="100"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Read services/signal/SignalCalculationEngine.ts — specifically where task_limit_min and task_limit_max are set on the enforcement package.</w:t></w:r></w:p><w:p><w:pPr><w:pBdr><w:left w:val="single" w:color="D44000" w:sz="12" w:space="6"/></w:pBdr><w:spacing w:after="100" w:before="100"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Read services/task-generation/TaskGenerationEngine.ts — specifically the context loading block at the top of the generation function.</w:t></w:r></w:p><w:p><w:pPr><w:pBdr><w:left w:val="single" w:color="D44000" w:sz="12" w:space="6"/></w:pBdr><w:spacing w:after="100" w:before="100"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Read the Blueprint model in prisma/schema.prisma — confirm the 7 archetype fields from Prompt 4 are present before starting.</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:pBdr><w:bottom w:val="single" w:color="D44000" w:sz="4" w:space="1"/></w:pBdr><w:spacing w:after="160" w:before="360"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="34"/><w:szCs w:val="34"/></w:rPr><w:t xml:space="preserve">C — WHAT TO BUILD (4 ADDITIONS)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="120" w:before="260"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t xml:space="preserve">Addition 1 — Primary loop: archetype context in enforcement package</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">The primary loop runs on every feedback submission. When the ConditionAssignmentEngine generates an enforcement package, it must read the archetype multipliers from the blueprint and apply them to the enforcement package output.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">This was partially defined in Prompt 4 Task 3. Confirm it is working end-to-end in the primary loop by adding a test log to ConditionAssignmentEngine that outputs the multiplier being applied.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// Add to EnforcementPackage creation in ConditionAssignmentEngine:</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const archetypeMult = blueprint?.archetype_execution_mult ?? 1.0;</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const adjustedMin = Math.max(1, Math.round(baseMin * archetypeMult));</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const adjustedMax = Math.min(8, Math.round(baseMax * archetypeMult));</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">logger.info(&apos;[ConditionAssignment] Archetype mult applied&apos;, {</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">  blueprint_id, archetypeMult, baseMin, baseMax, adjustedMin, adjustedMax</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">});</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="120" w:before="260"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t xml:space="preserve">Addition 2 — Daily loop: archetype timeframe pressure in window calculation</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">The daily loop runs every 24 hours and recalculates the 7-day rolling signal window. The archetype timeframe pressure multiplier adjusts how wide this window is — in high-pressure economies (multiplier &gt; 1), the window shortens. In slow economies (multiplier &lt; 1), it widens.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// In the daily signal recalculation worker:</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const timeMult = blueprint?.archetype_timeframe_mult ?? 1.0;</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// Base window: 7 days. Multiplier compresses or expands it.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// High-pressure economy (1.3x) → 7/1.3 ≈ 5.4 days</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// Slow economy (0.8x) → 7/0.8 = 8.75 days</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const windowDays = Math.round(7 / timeMult);</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const windowStart = new Date(now.getTime() - windowDays * 24 * 3600000);</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">GATE: A blueprint with archetype_timeframe_mult = 1.5 has a shorter rolling window than one with mult = 0.8. Verify by checking window_start in signal_snapshots for two different blueprints.</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="120" w:before="260"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t xml:space="preserve">Addition 3 — Background loop: archetype difficulty adjustment in task scoring</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">The background loop includes system health checks and task generation for idle blueprints. When the background loop generates tasks, it must apply archetype_difficulty_adj to the difficulty scoring. This means a blueprint in a High-Efficiency Manufacturing Economy (which has a positive difficulty adjustment) generates tasks that are scored as harder than the same blueprint would be in a Consumer Capitalist economy.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// In background TaskGenerationWorker context:</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const diffAdj = blueprint?.archetype_difficulty_adj ?? 0.0;</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// Apply to difficulty cap selection:</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// diffAdj &gt; 0 = harder economy, shift difficulty cap up one level</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// diffAdj &lt; 0 = easier economy, keep difficulty cap as-is</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const difficultyShift = diffAdj &gt; 0.3 ? 1 : diffAdj &lt; -0.3 ? -1 : 0;</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">const adjustedDifficulty = shiftDifficulty(base_difficulty_cap, difficultyShift);</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">function shiftDifficulty(cap: string, shift: number): string {</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">  const levels = [&apos;very_easy&apos;,&apos;easy&apos;,&apos;moderate&apos;,&apos;hard&apos;,&apos;very_hard&apos;];</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">  const idx = levels.indexOf(cap);</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">  return levels[Math.max(0, Math.min(4, idx + shift))];</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">}</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="120" w:before="260"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t xml:space="preserve">Addition 4 — Register archetype_context_loaded event</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">When any loop reads archetype data from the blueprint, it should emit a lightweight archetype_context_loaded event if the archetype data is missing (null). This alerts the system health worker that a blueprint is running without archetype context and triggers a re-read from the validation record.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">// In any loop that reads archetype fields:</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">if (!blueprint?.primary_archetype_id) {</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">  await emitEvent({</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">    event_type:  &apos;archetype_context_missing&apos;,</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">    entity_type: &apos;blueprint&apos;,</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">    entity_id:   blueprint_id,</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">    user_id,     blueprint_id,</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">    payload: { reason: &apos;archetype_fields_null&apos;, loop: &apos;primary|daily|background&apos; }</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">  });</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">}</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:pBdr><w:bottom w:val="single" w:color="D44000" w:sz="4" w:space="1"/></w:pBdr><w:spacing w:after="160" w:before="360"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="34"/><w:szCs w:val="34"/></w:rPr><w:t xml:space="preserve">D — ACCEPTANCE CRITERIA</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">[ ] Primary loop applies archetype_execution_mult to enforcement package task limits. Logged per cycle.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">[ ] Daily loop applies archetype_timeframe_mult to rolling window calculation. Window differs between archetypes.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">[ ] Background loop applies archetype_difficulty_adj to task difficulty cap.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">[ ] archetype_context_missing event emitted when blueprint is missing archetype fields.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">[ ] No existing loop behaviour removed or broken. All 20 existing loop acceptance criteria still pass.</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:pBdr><w:bottom w:val="single" w:color="D44000" w:sz="4" w:space="1"/></w:pBdr><w:spacing w:after="160" w:before="360"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:cs="Arial" w:eastAsia="Arial" w:hAnsi="Arial"/><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="34"/><w:szCs w:val="34"/></w:rPr><w:t xml:space="preserve">E — FINAL REPORT FORMAT</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">TORGIMA — PROMPT 5 ERECTOR ADDITIONS — BUILD REPORT</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">════════════════════════════════════════════════════</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="C