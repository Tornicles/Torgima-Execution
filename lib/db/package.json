{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./types/bhudhi": "./src/types/bhudhi.ts",
    "./bhudhi-seed-data": "./src/bhudhi-seed-data.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "check": "drizzle-kit check --config ./drizzle.config.ts",
    "seed": "tsx src/seed.ts",
    "seed:bhudhi": "tsx src/bhudhi-seed.ts",
    "verify": "tsx src/verify-db.ts",
    "verify:bhudhi": "tsx src/bhudhi-seed.ts --verify-only"
  },
  "dependencies": {
    "@workspace/state-machine": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
