# Copy to .env.cloudflare.local (gitignored) and load before cf:* commands.
# Create token: Cloudflare dashboard → My Profile → API Tokens → Create Token
# Template: "Edit Cloudflare Workers" (include Queues write for task queue provisioning)

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

