{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm run typecheck:libs && pnpm -r --if-present run build",
    "postbuild": "node scripts/ensure-cloudflare-queues.mjs",
    "deploy": "node scripts/ensure-cloudflare-queues.mjs && pnpm exec wrangler deploy",
    "typecheck:libs": "tsc -b tsconfig.json --force",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:unit": "pnpm -F @workspace/api-server exec vitest run src/tests/unit",
    "test:contracts": "pnpm -F @workspace/api-server exec vitest run src/tests/contracts",
    "test:acceptance": "pnpm -F @workspace/api-server exec vitest run src/tests/acceptance",
    "test:integration": "pnpm -F @workspace/api-server exec vitest run src/tests/integration",
    "test:api": "pnpm -F @workspace/api-server exec vitest run src/tests",
    "test": "pnpm test:api",
    "test:e2e": "pnpm -F @workspace/torgima exec playwright test",
    "test:phase9": "pnpm -F @workspace/scripts test:phase9",
    "test:system:e2e": "pnpm -F @workspace/scripts test:system:e2e",
    "test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:phase9",
    "lint": "eslint --max-warnings 0",
    "verify:system": "pnpm -F @workspace/scripts verify:system",
    "verify:lifecycle": "pnpm -F @workspace/scripts exec tsx ../scripts/verify-lifecycle.ts",
    "diagnose:signal-chain": "pnpm -F @workspace/scripts exec tsx ../scripts/diagnose-signal-chain.ts",
    "apply:production-gate": "node scripts/apply-production-gate.mjs",
    "diagnostic:complete": "pnpm -F @workspace/scripts diagnostic:complete",
    "backfill:25-sequences": "pnpm -F @workspace/scripts backfill:25-sequences",
    "verify:25-sequences": "node scripts/verify-25-sequences.mjs",
    "db:generate": "pnpm -F @workspace/db generate",
    "db:migrate": "pnpm -F @workspace/db migrate",
    "db:check": "pnpm -F @workspace/db check",
    "db:apply-manual": "pnpm -F @workspace/db exec tsx ../../scripts/apply-all-manual-migrations.mjs",
    "db:verify-onboarding-schema": "node scripts/verify-onboarding-goal-schema-columns.mjs",
    "db:compare-schema": "node scripts/compare-production-schema.mjs",
    "db:ci": "pnpm -F @workspace/db run push-force && pnpm db:apply-manual && pnpm -F @workspace/db exec tsx ../../scripts/ci-verify-schema.mjs",
    "postgres:up": "node scripts/start-local-postgres.mjs",
    "postgres:down": "node scripts/stop-local-postgres.mjs",
    "test:phase9:local": "node scripts/run-phase9-e2e.mjs",
    "test:phase9:production": "node scripts/run-phase9-production-acceptance.mjs",
    "test:doc36": "node scripts/run-doc36-e2e.mjs",
    "test:doc36:reset": "pnpm -F @workspace/scripts exec tsx ./doc36-reset-test-user.ts",
    "test:doc37": "node scripts/run-doc37-e2e.mjs",
    "reset:users": "pnpm -F @workspace/scripts exec tsx ./reset-execution-users.ts",
    "start:api": "node scripts/start-api.mjs",
    "db:migrate:prod": "pnpm -F @workspace/db migrate",
    "generate:api": "node scripts/generateOpenApi.mjs && pnpm -F @workspace/api-spec run codegen",
    "build:cloudflare:pages": "pnpm --filter @workspace/state-machine build && pnpm --filter @workspace/api-client-react build && pnpm --filter @workspace/torgima build",
    "deploy:cloudflare:pages": "pnpm exec wrangler pages deploy artifacts/torgima/dist --project-name=torgima-frontend",
    "ensure:cloudflare:queues": "node scripts/ensure-cloudflare-queues.mjs",
    "deploy:cloudflare:api": "node scripts/ensure-cloudflare-queues.mjs && pnpm exec wrangler deploy --config artifacts/api-server/wrangler.toml",
    "deploy:cloudflare:worker": "node scripts/ensure-cloudflare-queues.mjs && pnpm exec wrangler deploy",
    "provision:cloudflare": "node scripts/provision-cloudflare.mjs",
    "cf:verify": "node scripts/verify-cloudflare-auth.mjs && pnpm --filter @workspace/api-server build && pnpm exec wrangler deploy --dry-run",
    "cf:dev": "pnpm exec wrangler dev",
    "cf:deploy": "node scripts/cf-deploy.mjs",
    "cf:pages:deploy": "node scripts/verify-cloudflare-auth.mjs && pnpm run build:cloudflare:pages && pnpm run deploy:cloudflare:pages"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "embedded-postgres": "15.17.0-beta.17",
    "dotenv": "^16.4.7",
    "pg": "^8.20.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2",
    "wrangler": "4.40.0"
  }
}
