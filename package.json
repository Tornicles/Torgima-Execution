{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:unit": "pnpm -F @workspace/api-server exec vitest run src/tests/unit",
    "test:integration": "pnpm -F @workspace/api-server exec vitest run src/tests/integration",
    "test:api": "pnpm -F @workspace/api-server exec vitest run src/tests",
    "test:e2e": "pnpm -F @workspace/torgima exec playwright test",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "verify:system": "pnpm -F @workspace/scripts verify:system"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
