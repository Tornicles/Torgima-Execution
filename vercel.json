{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm -F @workspace/torgima build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "artifacts/torgima/dist/public",
  "framework": null,
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|png|jpg|jpeg|svg|webp|avif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
