{
  "version": 2,
  "buildCommand": "cd artifacts/torgima && pnpm run build",
  "outputDirectory": "artifacts/torgima/dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
