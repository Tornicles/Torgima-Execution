{
  "version": 2,
  "buildCommand": "cd artifacts/torgima && pnpm run build",
  "outputDirectory": "artifacts/torgima/dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
