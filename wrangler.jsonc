{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Cloudflare Workers Builds deploys from repo root by default.
  // Workers Builds deploy: `pnpm run deploy` or `npx wrangler deploy` (shim provisions queues).
  "name": "torgima",
  "main": "artifacts/api-server/src/worker.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "node:fs": "./artifacts/api-server/src/shims/node-fs.ts",
    "fs": "./artifacts/api-server/src/shims/node-fs.ts",
    "pino-http": "./artifacts/api-server/src/shims/pino-http-stub.ts"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "NODE_ENV": "production",
    "TORGIMA_RUNTIME": "cloudflare",
    "APP_URL": "https://torgima-frontend.pages.dev"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "aa13fb8cb21d44aa965fbcc7cc9ea1f7"
    }
  ],
  // Queues: uncomment after creating torgima-task-queue in Cloudflare dashboard
  // "queues": { "producers": [...], "consumers": [...] },
  "triggers": {
    "crons": [
      "0 2 * * *",
      "*/30 * * * *",
      "0 3 * * *",
      "*/10 * * * *",
      "* * * * *"
    ]
  }
}
